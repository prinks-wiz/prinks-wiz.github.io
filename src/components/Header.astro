---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../utils/url';

const navLinks = [
  { num: '01', href: url('/work'), label: 'Work' },
  { num: '02', href: url('/projects'), label: 'Projects' },
  { num: '03', href: url('/writing'), label: 'Writing' },
  { num: '04', href: url('/about'), label: 'About' },
  { num: '05', href: url('/contact'), label: 'Contact' },
];

const path = Astro.url.pathname;
---

<header class="border-b border-edge sticky top-0 z-40 bg-surface">
  <div class="max-w-[1200px] mx-auto px-6 py-4 md:py-5">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
      <!-- Name / Home -->
      <a
        href={url('/')}
        class="font-mono text-xs sm:text-sm font-bold text-content hover:text-accent transition-colors shrink-0 whitespace-nowrap"
      >
        Priyanka Vijaybaskar
      </a>

      <!-- Primary nav — hidden on mobile -->
      <nav
        aria-label="Main navigation"
        class="hidden sm:flex flex-wrap items-center gap-x-6 gap-y-2 md:gap-x-8"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`font-mono text-xs uppercase tracking-[0.1em] transition-colors ${
              path === link.href || path.startsWith(link.href)
                ? 'text-content underline underline-offset-4 decoration-accent decoration-1'
                : 'text-meta hover:text-content'
            }`}
            aria-current={
              path === link.href || path.startsWith(link.href)
                ? 'page'
                : undefined
            }
          >
            {link.num} / {link.label}
          </a>
        ))}
      </nav>

      <!-- Theme toggle -->
      <ThemeToggle />
    </div>

    <!-- Mobile nav -->
    <nav
      aria-label="Mobile navigation"
      class="sm:hidden pt-3 border-t border-edge mt-3 -mx-6 px-6"
    >
      <div class="flex flex-wrap gap-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`font-mono text-xs uppercase tracking-[0.1em] transition-colors ${
              path === link.href || path.startsWith(link.href)
                ? 'text-content underline underline-offset-4 decoration-accent decoration-1'
                : 'text-meta hover:text-content'
            }`}
            aria-current={
              path === link.href || path.startsWith(link.href)
                ? 'page'
                : undefined
            }
          >
            {link.num}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

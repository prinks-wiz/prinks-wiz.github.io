---
import { url } from '../utils/url';

// Three-body Keplerian orbit animation. Canvas-based, centered below the
// hero line. Each body follows its own true-Keplerian ellipse (independent
// orbits, not mutual gravity) so speed visibly varies with true anomaly —
// fast at periapsis, slow at apoapsis.
//
// Three independent effects layer on top of the base simulation, none of
// which touch its clock or state directly:
//   1. Scroll-driven parallax/tilt on the canvas element (CSS transform).
//   2. The shared orbital focus eases toward the cursor when it's over the
//      scene, and back to canvas-center when it isn't — "the sun chases
//      the mouse." Only active with a real pointer (not touch) and outside
//      prefers-reduced-motion.
//   3. Five real links to the site's other pages, arranged in a ring
//      around the canvas, with a small magnetic nudge toward the cursor.
//      These are the actual navigable elements — the orbiting dots
//      themselves are never click targets, since a moving hit area is bad
//      for both mouse and keyboard users.
//
// Canvas sizing reads `offsetWidth`/`offsetHeight` rather than
// `getBoundingClientRect`, because the latter reflects the *transformed*
// (tilted) box and would feed back into the simulation's scale.
const quickLinks = [
  { num: '01', label: 'WORK', href: url('/work'), xPct: 50.0, yPct: -10.0 },
  { num: '02', label: 'PROJECTS', href: url('/projects'), xPct: 107.0, yPct: 33.0 },
  { num: '03', label: 'WRITING', href: url('/writing'), xPct: 84.0, yPct: 99.0 },
  { num: '04', label: 'ABOUT', href: url('/about'), xPct: 16.0, yPct: 99.0 },
  { num: '05', label: 'CONTACT', href: url('/contact'), xPct: -7.0, yPct: 33.0 },
];
---
<section
  id="orbital-animation-section"
  class="w-full flex flex-col items-center justify-center gap-6 min-h-[60vh] md:min-h-[70vh] py-4"
  style="perspective: 1200px;"
>
  <div id="orbital-wrapper" class="relative w-full max-w-3xl aspect-square">
    <canvas
      id="orbital-canvas"
      class="absolute inset-0 w-full h-full"
      style="display: block; will-change: transform;"
      role="img"
      aria-label="Ambient animation of three bodies tracing elliptical orbits"
    ></canvas>

    <!-- Desktop: links ringed around the canvas, with a magnetic cursor nudge -->
    <nav aria-label="Quick links" class="hidden md:block">
      {quickLinks.map((link) => (
        <a
          href={link.href}
          class="orbit-link absolute font-mono text-xs uppercase tracking-[0.1em] text-meta hover:text-accent focus-visible:text-accent transition-colors whitespace-nowrap"
          style={`left: ${link.xPct}%; top: ${link.yPct}%; transform: translate(-50%, -50%);`}
        >
          {link.num} / {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile: same links, as a normal-flow row below the animation -->
  <nav aria-label="Quick links" class="md:hidden flex flex-wrap justify-center gap-x-4 gap-y-2 px-6 w-full max-w-md">
    {quickLinks.map((link) => (
      <a
        href={link.href}
        class="font-mono text-xs uppercase tracking-[0.1em] text-meta hover:text-accent transition-colors"
      >
        {link.num} / {link.label}
      </a>
    ))}
  </nav>
</section>

<style>
  .orbit-link {
    transform: translate(-50%, -50%) translate(var(--nudge-x, 0px), var(--nudge-y, 0px));
    transition: transform 150ms ease-out, color 150ms ease;
  }
</style>

<script>
  interface Body {
    a: number;         // semi-major axis, as a fraction of the canvas half-size
    e: number;         // eccentricity
    T: number;         // period, seconds
    phase: number;     // initial argument of periapsis, radians
    radius: number;    // dot radius, px
    incl: number;      // orbital plane tilt, radians — what makes the ellipse read as 3D
    precession: number; // rad/sec drift of the periapsis — keeps the pattern from repeating exactly
  }

  const bodies: Body[] = [
    { a: 0.20, e: 0.15, T: 21, phase: 0, radius: 10, incl: 1.02, precession: 0.010 },
    { a: 0.34, e: 0.35, T: 26, phase: (2 * Math.PI) / 3, radius: 13, incl: 0.73, precession: -0.007 },
    { a: 0.46, e: 0.5, T: 30, phase: (4 * Math.PI) / 3, radius: 16, incl: 0.44, precession: 0.005 },
  ];

  const TRAIL_MS = 2000; // ~2s fading trail, independent of frame rate
  const MAX_FOCUS_DRIFT = 0.32; // cursor can pull the shared focus up to this × R from center
  const FOCUS_EASE = 0.07; // per-frame lerp factor toward the target focus

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
  let prefersReduced = motionQuery.matches;

  const section = document.getElementById('orbital-animation-section');
  const wrapper = document.getElementById('orbital-wrapper');
  const canvas = document.getElementById('orbital-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d') ?? null;
  const orbitLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.orbit-link'));

  if (section && wrapper && canvas && ctx) {
    let W = 0, H = 0, baseCenterX = 0, baseCenterY = 0, R = 0;
    let centerX = 0, centerY = 0; // eased, cursor-following focus
    let targetCenterX = 0, targetCenterY = 0;
    let orbitColorBack = 'rgba(158, 158, 158, 0.16)';
    let orbitColorFront = 'rgba(31, 79, 216, 0.45)';
    let accentColor = '#1F4FD8';
    let accentTrailBase = '31, 79, 216'; // r,g,b for the accent, used with alpha

    function hexToRgbTriplet(hex: string): string {
      const m = hex.trim().match(/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i);
      if (!m) return '31, 79, 216';
      const [r, g, b] = m.slice(1).map((h) => parseInt(h, 16));
      return `${r}, ${g}, ${b}`;
    }

    // Two path colors carry the 3D read: the half of each ellipse curving
    // away from the viewer is dim neutral gray, the half curving toward
    // the viewer is tinted accent and brighter — the same trick used to
    // sell a tilted ring as three-dimensional without a real z-buffer.
    function readColors(): void {
      const styles = getComputedStyle(document.documentElement);
      const border = styles.getPropertyValue('--border').trim() || '#DEDEDA';
      accentColor = styles.getPropertyValue('--accent').trim() || '#1F4FD8';
      accentTrailBase = hexToRgbTriplet(accentColor);
      const borderRgb = hexToRgbTriplet(border);
      orbitColorBack = `rgba(${borderRgb}, 0.16)`;
      orbitColorFront = `rgba(${accentTrailBase}, 0.45)`;
    }

    // offsetWidth/offsetHeight are layout dimensions — untouched by the
    // scroll-driven CSS transform below, unlike getBoundingClientRect.
    function resize(): void {
      const cssW = canvas.offsetWidth;
      const cssH = canvas.offsetHeight;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      W = cssW;
      H = cssH;
      baseCenterX = W / 2;
      baseCenterY = H / 2;
      centerX = targetCenterX = baseCenterX;
      centerY = targetCenterY = baseCenterY;
      R = Math.min(W, H) / 2;
      trails.forEach((t) => (t.length = 0));
    }

    function trueAnomaly(E: number, e: number): number {
      return 2 * Math.atan2(Math.sqrt(1 + e) * Math.sin(E / 2), Math.sqrt(1 - e) * Math.cos(E / 2));
    }

    function solveKepler(M: number, e: number): number {
      let E = M;
      for (let i = 0; i < 5; i++) E = M + e * Math.sin(E);
      return E;
    }

    interface Point3 { x: number; y: number; depth: number } // x,y local (un-translated); depth in [-1,1]

    // The orbit is computed flat (in-plane), then tilted around the
    // horizontal axis by `incl`: the in-plane y compresses toward the
    // canvas by cos(incl), and the same in-plane y (normalized to
    // [-1, 1] by the ellipse's own extent) becomes `depth` — how far
    // toward or away from the viewer that point sits. depth >= 0 is
    // "in front of" the shared focus; depth < 0 is "behind" it.
    function positionAt3D(body: Body, meanAnomaly: number, effPhase: number): Point3 {
      const E = solveKepler(meanAnomaly, body.e);
      const nu = trueAnomaly(E, body.e);
      const a = body.a * R;
      const r = (a * (1 - body.e ** 2)) / (1 + body.e * Math.cos(nu));
      const xOrb = r * Math.cos(nu + effPhase);
      const yOrb = r * Math.sin(nu + effPhase);
      const maxExtent = a * (1 + body.e);
      return {
        x: xOrb,
        y: yOrb * Math.cos(body.incl),
        depth: maxExtent > 0 ? yOrb / maxExtent : 0,
      };
    }

    function drawFocus(): void {
      const glowR = R * 0.42;
      const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, glowR);
      gradient.addColorStop(0, `rgba(${accentTrailBase}, 0.18)`);
      gradient.addColorStop(1, `rgba(${accentTrailBase}, 0)`);
      ctx.fillStyle = gradient;
      ctx.fillRect(centerX - glowR, centerY - glowR, glowR * 2, glowR * 2);

      // A small solid point at the shared focus — the thing the front
      // arcs visually pass in front of, and the back arcs pass behind.
      ctx.shadowBlur = 10;
      ctx.shadowColor = accentColor;
      ctx.fillStyle = accentColor;
      ctx.beginPath();
      ctx.arc(centerX, centerY, 3, 0, 2 * Math.PI);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    // Draws only the front (depth >= 0) or back (depth < 0) half of the
    // tilted ellipse, as one or more subpaths — a simple painter's-
    // algorithm split so the ring can pass behind the focus on one side
    // and in front of it on the other.
    function drawOrbitArc(body: Body, effPhase: number, front: boolean): void {
      ctx.shadowBlur = 0;
      ctx.strokeStyle = front ? orbitColorFront : orbitColorBack;
      ctx.lineWidth = front ? 1.6 : 0.8;
      ctx.beginPath();
      let drawing = false;
      for (let deg = 0; deg <= 360; deg += 3) {
        const p = positionAt3D(body, (deg * Math.PI) / 180, effPhase);
        const isFront = p.depth >= 0;
        if (isFront === front) {
          const x = centerX + p.x;
          const y = centerY + p.y;
          if (!drawing) { ctx.moveTo(x, y); drawing = true; }
          else ctx.lineTo(x, y);
        } else {
          drawing = false;
        }
      }
      ctx.stroke();
    }

    function drawTrail(trail: { x: number; y: number; t: number }[], now: number, alphaMul: number): void {
      if (trail.length < 2) return;
      ctx.shadowBlur = 0;
      ctx.lineCap = 'round';
      for (let i = 0; i < trail.length - 1; i++) {
        const age = now - trail[i].t;
        const life = Math.max(0, 1 - age / TRAIL_MS);
        const alpha = life ** 1.6 * 0.85 * alphaMul; // eased falloff — fades fast near the tail
        if (alpha <= 0.01) continue;
        ctx.strokeStyle = `rgba(${accentTrailBase}, ${alpha})`;
        ctx.lineWidth = 0.6 + life * 1.8; // tapers thin toward the tail
        ctx.beginPath();
        ctx.moveTo(trail[i].x, trail[i].y);
        ctx.lineTo(trail[i + 1].x, trail[i + 1].y);
        ctx.stroke();
      }
    }

    function drawBody(x: number, y: number, radius: number, alphaMul: number): void {
      const r = radius * (0.88 + alphaMul * 0.24); // nearer bodies read slightly larger
      ctx.globalAlpha = alphaMul;
      ctx.shadowBlur = 8 + r * 1.3;
      ctx.shadowColor = accentColor;
      ctx.fillStyle = accentColor;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, 2 * Math.PI);
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.globalAlpha = 1;
    }

    let isVisible = true;
    let animId = 0;
    let startTime = performance.now();
    let lastElapsedMs = 0;

    const trails: { x: number; y: number; t: number }[][] = bodies.map(() => []);

    // depth in [-1, 1] -> brightness/size multiplier in [0.55, 1]
    function depthAlpha(depth: number): number {
      return 0.55 + 0.45 * ((depth + 1) / 2);
    }

    function renderFrame(elapsedMs: number): void {
      lastElapsedMs = elapsedMs;
      centerX += (targetCenterX - centerX) * FOCUS_EASE;
      centerY += (targetCenterY - centerY) * FOCUS_EASE;
      ctx.clearRect(0, 0, W, H);

      const elapsedSec = elapsedMs / 1000;
      const now = elapsedMs;

      const states = bodies.map((body, i) => {
        const effPhase = body.phase + elapsedSec * body.precession;
        const meanAnomaly = ((elapsedSec / body.T) * 2 * Math.PI) % (2 * Math.PI);
        const local = positionAt3D(body, meanAnomaly, effPhase);
        const pos = { x: centerX + local.x, y: centerY + local.y, depth: local.depth };
        const trail = trails[i];
        trail.push({ x: pos.x, y: pos.y, t: now });
        while (trail.length && now - trail[0].t > TRAIL_MS) trail.shift();
        return { body, effPhase, pos, trail };
      });

      // Painter's algorithm, back to front: the ring passes behind the
      // focus on one side and in front of it on the other.
      states.forEach(({ body, effPhase }) => drawOrbitArc(body, effPhase, false));
      states.forEach(({ body, pos, trail }) => {
        if (pos.depth < 0) {
          const a = depthAlpha(pos.depth);
          drawTrail(trail, now, a);
          drawBody(pos.x, pos.y, body.radius, a);
        }
      });
      drawFocus();
      states.forEach(({ body, effPhase }) => drawOrbitArc(body, effPhase, true));
      states.forEach(({ body, pos, trail }) => {
        if (pos.depth >= 0) {
          const a = depthAlpha(pos.depth);
          drawTrail(trail, now, a);
          drawBody(pos.x, pos.y, body.radius, a);
        }
      });
    }

    function animate(time: number): void {
      if (!isVisible) {
        animId = 0;
        return;
      }
      renderFrame(time - startTime);
      animId = requestAnimationFrame(animate);
    }

    function drawStaticFrame(): void {
      ctx.clearRect(0, 0, W, H);
      const states = bodies.map((body) => {
        const local = positionAt3D(body, body.phase, body.phase);
        return { body, pos: { x: centerX + local.x, y: centerY + local.y, depth: local.depth } };
      });
      states.forEach(({ body }) => drawOrbitArc(body, body.phase, false));
      states.forEach(({ body, pos }) => {
        if (pos.depth < 0) drawBody(pos.x, pos.y, body.radius, depthAlpha(pos.depth));
      });
      drawFocus();
      states.forEach(({ body }) => drawOrbitArc(body, body.phase, true));
      states.forEach(({ body, pos }) => {
        if (pos.depth >= 0) drawBody(pos.x, pos.y, body.radius, depthAlpha(pos.depth));
      });
    }

    function start(): void {
      readColors();
      resize();
      if (prefersReduced) {
        drawStaticFrame();
        return;
      }
      startTime = performance.now();
      if (!animId) animId = requestAnimationFrame(animate);
    }

    start();

    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible && !prefersReduced && !animId) {
          startTime = performance.now() - lastElapsedMs;
          trails.forEach((t) => (t.length = 0));
          animId = requestAnimationFrame(animate);
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(canvas);

    document.addEventListener('themechange', () => {
      readColors();
      if (prefersReduced) drawStaticFrame();
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (prefersReduced) drawStaticFrame();
        updateTilt();
      }, 150);
    });

    // ── Scroll parallax + tilt ──────────────────────────────────────────
    // Fully independent of the simulation above: reads the section's own
    // (untransformed) bounding box, derives how far it sits from the
    // viewport's vertical center, and applies that as a small translate +
    // rotateX + scale on the canvas. The orbit simulation keeps running on
    // its own clock throughout — scroll only perturbs the "camera".
    function updateTilt(): void {
      if (prefersReduced) {
        canvas.style.transform = '';
        return;
      }
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const sectionCenter = rect.top + rect.height / 2;
      const raw = (sectionCenter - vh / 2) / vh;
      const progress = Math.max(-1, Math.min(1, raw));

      const translateY = progress * -28; // px drift, opposite the scroll direction
      const tiltDeg = progress * 7;
      const scale = 1 - Math.abs(progress) * 0.035;

      canvas.style.transform =
        `translateY(${translateY.toFixed(2)}px) scale(${scale.toFixed(3)}) rotateX(${tiltDeg.toFixed(2)}deg)`;
    }

    if (!prefersReduced) {
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateTilt();
            ticking = false;
          });
        },
        { passive: true }
      );
      updateTilt();
    }

    // ── Cursor tracking ──────────────────────────────────────────────────
    // The shared orbital focus eases toward the cursor (clamped to a
    // radius around center so bodies stay on-canvas), and each ring link
    // nudges a few pixels toward the cursor when it's nearby. Both read
    // the same pointer position; neither runs on touch or under reduced
    // motion — there's no hover to track, and it's non-essential motion.
    if (!prefersReduced && !coarsePointer) {
      const LINK_PULL_RADIUS = 140;
      const LINK_MAX_NUDGE = 10;

      wrapper.addEventListener('mousemove', (e: MouseEvent) => {
        const canvasRect = canvas.getBoundingClientRect();
        const scaleX = W / canvasRect.width;
        const scaleY = H / canvasRect.height;
        const localX = (e.clientX - canvasRect.left) * scaleX;
        const localY = (e.clientY - canvasRect.top) * scaleY;
        const dx = localX - baseCenterX;
        const dy = localY - baseCenterY;
        const dist = Math.hypot(dx, dy);
        const maxDrift = R * MAX_FOCUS_DRIFT;
        const clamped = dist > maxDrift ? maxDrift / dist : 1;
        targetCenterX = baseCenterX + dx * clamped;
        targetCenterY = baseCenterY + dy * clamped;

        orbitLinks.forEach((link) => {
          const rect = link.getBoundingClientRect();
          const lx = rect.left + rect.width / 2;
          const ly = rect.top + rect.height / 2;
          const ldx = e.clientX - lx;
          const ldy = e.clientY - ly;
          const ldist = Math.hypot(ldx, ldy);
          if (ldist < LINK_PULL_RADIUS) {
            const pull = (1 - ldist / LINK_PULL_RADIUS) * LINK_MAX_NUDGE;
            const nx = (ldx / (ldist || 1)) * pull;
            const ny = (ldy / (ldist || 1)) * pull;
            link.style.setProperty('--nudge-x', `${nx.toFixed(1)}px`);
            link.style.setProperty('--nudge-y', `${ny.toFixed(1)}px`);
          } else {
            link.style.setProperty('--nudge-x', '0px');
            link.style.setProperty('--nudge-y', '0px');
          }
        });
      });

      wrapper.addEventListener('mouseleave', () => {
        targetCenterX = baseCenterX;
        targetCenterY = baseCenterY;
        orbitLinks.forEach((link) => {
          link.style.setProperty('--nudge-x', '0px');
          link.style.setProperty('--nudge-y', '0px');
        });
      });
    }

    motionQuery.addEventListener('change', (e) => {
      prefersReduced = e.matches;
      if (prefersReduced) {
        canvas.style.transform = '';
        if (animId) {
          cancelAnimationFrame(animId);
          animId = 0;
        }
        drawStaticFrame();
      } else {
        start();
        updateTilt();
      }
    });
  }
</script>

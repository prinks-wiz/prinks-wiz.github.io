---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import OrbitalAnimation from '../components/OrbitalAnimation.astro';
import Ticker from '../components/Ticker.astro';
---

<BaseLayout title="Vision for physical AI">
  <Hero />
  <OrbitalAnimation />
  <Ticker />

  <!-- Brief intro section below fold -->
  <section class="w-full bg-surface py-16 md:py-24">
    <div class="max-w-[680px] mx-auto px-6">
      <p class="text-lg text-secondary leading-relaxed">
        I build vision systems that hold up on real hardware. Spacecraft is where
        I test that today. A model that can't be patched after launch has to
        <strong class="font-semibold text-content">work the first time</strong>,
        and that constraint is the whole problem worth solving.
      </p>
    </div>
  </section>
</BaseLayout>

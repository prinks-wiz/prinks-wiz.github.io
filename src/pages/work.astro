---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkEntry from '../components/WorkEntry.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('work');

// Most recent role first
const sorted = entries.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);
---
<BaseLayout
  title="Work — Priyanka Vijaybaskar"
  description="Research and professional experience in machine learning and perception."
>
  <div class="max-w-[720px] mx-auto px-6 py-16">

    <SectionHeader number="01" title="WORK" />

    <h1 class="text-2xl font-semibold text-content tracking-tight mb-4">
      Experience
    </h1>
    <p class="text-secondary leading-relaxed mb-12 max-w-[36rem]">
      A quick rundown of where I've worked and what I actually built, role by role.
      Most of it circles back to the same question: does this hold up outside the
      conditions it was built and tested in?
    </p>

    {sorted.map(entry => (
      <WorkEntry
        org={entry.data.org}
        role={entry.data.role}
        startDate={entry.data.startDate}
        endDate={entry.data.endDate}
        description={entry.data.description}
        techStack={entry.data.techStack}
        location={entry.data.location}
      />
    ))}

  </div>
</BaseLayout>
